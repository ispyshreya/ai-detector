# Veil detector-trainer — API keys for WILD-SET generation only.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# None of these are needed for building the pipeline or training on public data —
# only for generating the DALL·E 3 / Flux wild-test images (~$10, run explicitly).

# --- DALL·E 3 wild-set (~200 images, ~$8) --------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Flux wild-set (~400 images, ~$1-2) ----------------------------------------
# Preferred: Replicate. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Free alternative to Replicate for Flux (slower, rate-limited).
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Kaggle (datasets + training kernels) --------------------------------------
# Already configured at ~/.kaggle/kaggle.json — no need to duplicate here.
# Only set these if you prefer env-var auth instead of the json file:
# KAGGLE_USERNAME=
# KAGGLE_KEY=
